# Production environment - promoted by the Jenkins Release stage (same artefact as staging)
APP_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
AUTH_RATE_LIMIT=50
BCRYPT_ROUNDS=10
# Enables the key-protected incident-simulation endpoint used by the Monitoring stage.
# The key is generated on the server and never stored in the repository.
CHAOS_ENABLED=true
