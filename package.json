{
  "name": "proofsprint",
  "version": "1.0.0",
  "description": "ProofSprint - AI-assisted customer-discovery sprints for non-technical student founders (SIT223 7.3HD DevOps pipeline project)",
  "main": "src/server.js",
  "private": true,
  "author": "Aaryan Dandona (s224842524)",
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o reports/eslint.json",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "lint:ci": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && eslint . && eslint . -f json -o reports/eslint.json"
  },
  "engines": {
    "node": ">=18"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "addFileAttribute": "true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.0"
  }
}
